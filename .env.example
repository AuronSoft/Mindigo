APP_NAME=MindigoLMS
APP_ENV=production
APP_KEY=check_readme_to_generate_key
APP_DEBUG=true
APP_URL=https://moviebox.com
APP_TIMEZONE=Asia/Ho_Chi_Minh

LOG_CHANNEL=stack
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=movie-box
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file 
QUEUE_CONNECTION=sync
CACHE_STORE=file

FILESYSTEM_DISK=local
COURSE_REVIEW_MINIMUM_COMPLETION=100
MAIL_MAILER=log

GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_TUTOR_MODEL=gemini-2.5-flash
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta

VITE_APP_NAME="MindingoLMS"

# Mindigo Native WebRTC infrastructure (use your own coturn/STUN service in production)
LIVE_MEDIA_STUN_URL=
LIVE_MEDIA_TURN_URLS=turn:127.0.0.1:3478?transport=udp,turn:127.0.0.1:3478?transport=tcp
LIVE_MEDIA_TURN_FAILOVER_URLS=
LIVE_MEDIA_TURN_HEALTH_URL=
LIVE_MEDIA_TURN_FAILOVER_HEALTH_URL=
LIVE_MEDIA_TURN_AUTH_SECRET=
LIVE_MEDIA_TURN_REALM=mindigo.local
LIVE_MEDIA_TURN_CREDENTIAL_TTL=600
LIVE_MEDIA_TURN_HEALTH_CACHE=90
LIVE_MEDIA_TURN_FAIL_OPEN=true
LIVE_MEDIA_TURN_MAX_BITRATE_KBPS=2500
LIVE_MEDIA_TURN_EXTERNAL_IP=127.0.0.1
LIVE_MEDIA_TURN_MIN_PORT=49160
LIVE_MEDIA_TURN_MAX_PORT=49200
LIVE_MEDIA_TURN_MAX_BPS=312500
LIVE_MEDIA_TURN_TOTAL_BPS=50000000
LIVE_MEDIA_TURN_USER_QUOTA=4
LIVE_MEDIA_TURN_TOTAL_QUOTA=500
LIVE_MEDIA_TOPOLOGY=mesh
LIVE_MEDIA_SFU_HEALTH_URL=
LIVE_MEDIA_SAFE_MESH_CAPACITY=8
LIVE_MEDIA_GATEWAY_URL=ws://127.0.0.1:8090
LIVE_MEDIA_GATEWAY_HEALTH_URL=http://127.0.0.1:8091/health
LIVE_MEDIA_GATEWAY_SECRET=
LIVE_MEDIA_GATEWAY_TICKET_TTL=120
LIVE_MEDIA_REDIS_URL=redis://127.0.0.1:6379
LIVE_MEDIA_ANNOUNCED_IP=127.0.0.1
LIVE_MEDIA_RTC_MIN_PORT=40000
LIVE_MEDIA_RTC_MAX_PORT=40100

# Optional external live meeting providers. Mindigo Native remains the default and fallback.
GOOGLE_MEET_CLIENT_ID=
GOOGLE_MEET_CLIENT_SECRET=
GOOGLE_MEET_REDIRECT_URI="${APP_URL}/teacher/live-providers/google_meet/callback"
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_REDIRECT_URI="${APP_URL}/teacher/live-providers/zoom/callback"
ZOOM_OAUTH_SCOPES="meeting:write:meeting meeting:read:meeting"
LIVE_PROVIDER_HTTP_TIMEOUT=10
LIVE_PROVIDER_CONNECT_TIMEOUT=3
LIVE_PROVIDER_HTTP_RETRIES=2
LIVE_PROVIDER_CIRCUIT_FAILURE_THRESHOLD=3
LIVE_PROVIDER_CIRCUIT_COOLDOWN=300
