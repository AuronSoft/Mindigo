    "type": "library",
    "require": {
        "php": "^8.2",
        "illuminate/support": "^12.0",
        "mindigo/audit-log": "*",
        "mindigo/auth": "*",
        "mindigo/exam-management": "*",
        "mindigo/teacher-assignment": "*",
        "mindigo/teacher-classroom": "*",
        "mindigo/teacher-live-session": "*"
    },
