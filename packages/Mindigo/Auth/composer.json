{
    "name": "mindigo/auth",
    "description": "Mindigo Authentication Package",
    "type": "library",

    "license": "MIT",

    "minimum-stability": "dev",
    "prefer-stable": true,

    "require": {
        "php": "^8.2",
        "illuminate/support": "^12.0",
        "illuminate/auth": "^12.0",
        "illuminate/database": "^12.0",
        "illuminate/routing": "^12.0"
    },

    "autoload": {
        "psr-4": {
            "Mindigo\\Auth\\": "src/"
        }
    },

    "extra": {
        "laravel": {
            "providers": [
                "Mindigo\\Auth\\Providers\\AuthServiceProvider"
            ]
        }
    }
}